# 如果使用 wrangler CLI 部署，复制为 wrangler.toml 并填入 database_id
# 纯网页部署可忽略本文件，直接在 Cloudflare 控制台配置绑定和定时触发器
name = "seraphine-stats"
main = "worker.js"
compatibility_date = "2026-10-12"

# 每天 UTC 00:17 写一条在线人数快照
[triggers]
crons = ["17 0 * * *"]

[[d1_databases]]
binding = "DB"
database_name = "seraphine-stats"
database_id = "在 D1 控制台创建数据库后把 ID 填到这里"

# REPORT_KEY / ADMIN_PASS 不要写在这里（会进 git），
# 用 wrangler secret put REPORT_KEY 和 wrangler secret put ADMIN_PASS 设置
